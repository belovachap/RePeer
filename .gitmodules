[submodule "src/leveldb"]
	path = src/leveldb
	url = https://github.com/google/leveldb.git
	ignore = untracked
[submodule "src/minisketch"]
	path = src/minisketch
	url = https://github.com/bitcoin-core/minisketch.git
[submodule "src/secp256k1"]
	path = src/secp256k1
	url = https://github.com/bitcoin-core/secp256k1.git
